#!/usr/bin/env python3
"""
mac-earbuds-ctl: Wireless earbuds & 360 Spatial Audio helper for MacShell.

Features:
  - Non-blocking BlueZ D-Bus discovery via busctl (~3 ms, zero hang)
  - Native Samsung Galaxy Buds RFCOMM SPP framing (ANC / Ambient / Adaptive / Off,
    6-preset Equalizer, Touchpad Lock, Low-Latency Gaming Mode) dispatched
    asynchronously off the UI thread, plus optional GalaxyBudsClient forwarding
  - Generic Bluetooth Audio A2DP profile & battery support (AirPods, Sony, Bose,
    Sennheiser, Nothing Ear, Beats, Soundcore, JBL, etc.)
  - Software 360 Spatial Audio virtual sink (PipeWire pw-loopback) & low-latency
    PipeWire quantum toggle
  - Optional user driver overrides in ~/.config/macshell/earbuds.d/*.sh
"""
import glob
import json
import os
import re
import select
import shutil
import signal
import socket
import struct
import subprocess
import sys
import time

CONFIG_HOME = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
RUNTIME_DIR = os.environ.get("XDG_RUNTIME_DIR") or "/tmp"
STATE_PATH = os.path.join(CONFIG_HOME, "macshell", "earbuds-state.json")
DRIVERS_DIR = os.path.join(CONFIG_HOME, "macshell", "earbuds.d")
SPATIAL_PID_FILE = os.path.join(RUNTIME_DIR, "macshell-spatial360.pid")
SPATIAL_SOFA_CONF = os.path.join(CONFIG_HOME, "macshell", "spatial-sofa.conf")
UNIX_SOCK_PATH = os.path.join(RUNTIME_DIR, "macshell-earbuds.sock")

DEFAULT_EQ = ["Normal", "Bass Boost", "Soft", "Dynamic", "Clear", "Treble Boost"]

DEFAULT_STATE = {
    "selectedMac": "",
    "cachedName": "Wireless Buds",
    "rfcommChannel": 27,
    "noiseControl": "anc",
    "eqPreset": "Dynamic",
    "spatial360": False,
    "touchLock": False,
    "lowLatency": False,
}

BUILTIN_DRIVERS = [
    {
        "id": "samsung-buds",
        "brand": "Samsung",
        "regex": r"buds|galaxy|samsung",
        "modes": ["off", "ambient", "adaptive", "anc"],
        "eq": DEFAULT_EQ,
    },
    {
        "id": "generic-bt",
        "brand": "Bluetooth Audio",
        "regex": r".*",
        "modes": ["off", "ambient", "adaptive", "anc"],
        "eq": DEFAULT_EQ,
    },
]

AUDIO_NAME_RE = re.compile(
    r"buds|airpods|headphones|earbuds|headset|wh-|wf-|sony|bose|sennheiser|jbl|nothing|beats|anker|soundcore",
    re.IGNORECASE,
)


def run_cmd(args, timeout=1.8):
    try:
        r = subprocess.run(
            args,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=timeout,
        )
        return r.stdout.strip()
    except Exception:
        return ""


def command_exists(name):
    return shutil.which(name) is not None


def load_state():
    st = dict(DEFAULT_STATE)
    if os.path.exists(STATE_PATH):
        try:
            with open(STATE_PATH, "r", encoding="utf-8") as f:
                data = json.load(f)
                if isinstance(data, dict):
                    st.update(data)
        except Exception:
            pass
    return st


def save_state(st):
    try:
        os.makedirs(os.path.dirname(STATE_PATH), exist_ok=True)
        tmp = STATE_PATH + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(st, f, indent=2)
        os.replace(tmp, STATE_PATH)
    except Exception:
        pass


def load_drivers():
    drivers = []
    if os.path.isdir(DRIVERS_DIR):
        for p in sorted(glob.glob(os.path.join(DRIVERS_DIR, "*.sh"))):
            try:
                with open(p, "r", encoding="utf-8") as f:
                    txt = f.read()
                d_id = re.search(r'DRIVER_ID="([^"]+)"', txt)
                d_brand = re.search(r'DRIVER_BRAND="([^"]+)"', txt)
                d_regex = re.search(r'MATCH_REGEX="([^"]+)"', txt)
                d_modes = re.search(r"SUPPORTED_MODES='([^']+)'", txt)
                d_eq = re.search(r"SUPPORTED_EQ='([^']+)'", txt)
                drivers.append(
                    {
                        "id": d_id.group(1) if d_id else os.path.basename(p),
                        "brand": d_brand.group(1) if d_brand else "Generic",
                        "regex": d_regex.group(1) if d_regex else ".*",
                        "modes": json.loads(d_modes.group(1)) if d_modes else ["off", "ambient", "adaptive", "anc"],
                        "eq": json.loads(d_eq.group(1)) if d_eq else DEFAULT_EQ,
                    }
                )
            except Exception:
                pass
    known_ids = {d["id"] for d in drivers}
    for bd in BUILTIN_DRIVERS:
        if bd["id"] not in known_ids:
            drivers.append(dict(bd))
    drivers.sort(key=lambda d: 1 if d["id"] == "generic-bt" else 0)
    return drivers


def match_driver(dev_name, drivers):
    for d in drivers:
        if d["id"] == "generic-bt":
            continue
        if re.search(d["regex"], dev_name or "", re.IGNORECASE):
            return d
    return drivers[-1] if drivers else BUILTIN_DRIVERS[0]


def bt_hardware_ready() -> bool:
    try:
        return os.path.isdir("/sys/class/bluetooth") and len(os.listdir("/sys/class/bluetooth")) > 0
    except Exception:
        return False


def get_bt_audio_devices():
    if not bt_hardware_ready():
        return []
    raw = run_cmd(
        [
            "busctl",
            "--system",
            "-j",
            "call",
            "org.bluez",
            "/",
            "org.freedesktop.DBus.ObjectManager",
            "GetManagedObjects",
        ],
        timeout=0.6,
    )
    if not raw:
        return []

    devices = []
    try:
        payload = json.loads(raw)
        objs = (payload.get("data") or [{}])[0]
        for _, ifaces in objs.items():
            dev = ifaces.get("org.bluez.Device1")
            if not dev:
                continue

            def val(k, default=None):
                v = dev.get(k)
                return v.get("data", default) if isinstance(v, dict) else default

            mac = str(val("Address", "") or "")
            name = str(val("Name", "") or val("Alias", "") or "")
            if not mac or not name:
                continue
            icon = str(val("Icon", "") or "").lower()
            uuids = " ".join(str(u) for u in (val("UUIDs", []) or [])).lower()
            is_audio = (
                "audio" in icon
                or "headset" in icon
                or "headphones" in icon
                or "0000110b-" in uuids
                or "0000111e-" in uuids
                or "00001108-" in uuids
                or bool(AUDIO_NAME_RE.search(name))
            )
            if not is_audio:
                continue
            is_conn = bool(val("Connected", False))
            paired = bool(val("Paired", False) or val("Bonded", False))
            bat_iface = ifaces.get("org.bluez.Battery1") or {}
            bat_v = bat_iface.get("Percentage")
            bat = int(bat_v["data"]) if isinstance(bat_v, dict) and bat_v.get("data") is not None else None
            devices.append(
                {
                    "mac": mac,
                    "name": name,
                    "connected": is_conn,
                    "paired": paired,
                    "battery": bat,
                }
            )
    except Exception:
        pass
    devices.sort(key=lambda d: (not d["connected"], not d["paired"], d["name"]))
    return devices


def get_earbuds_battery(fallback_bat, st=None):
    if st:
        bat_l = st.get("batteryL")
        bat_r = st.get("batteryR")
        bat_case = st.get("batteryCase")
        if bat_l is not None or bat_r is not None:
            return {"left": bat_l or fallback_bat, "right": bat_r or fallback_bat, "case": bat_case}
    gb_cache = os.path.join(CONFIG_HOME, "GalaxyBudsClient", "state.json")
    if os.path.exists(gb_cache):
        try:
            with open(gb_cache, "r", encoding="utf-8") as f:
                d = json.load(f)
                return {
                    "left": d.get("batteryL", fallback_bat),
                    "right": d.get("batteryR", fallback_bat),
                    "case": d.get("batteryCase", None),
                }
        except Exception:
            pass
    if fallback_bat is not None:
        return {"left": fallback_bat, "right": fallback_bat, "case": None}
    return {"left": None, "right": None, "case": None}


def get_active_bt_codec():
    raw = run_cmd(["pactl", "list", "sinks"], timeout=0.7)
    if raw:
        m = re.search(r'api\.bluez5\.codec\s*=\s*"([^"]+)"', raw)
        if m:
            return m.group(1).upper()
    return "A2DP Stereo"


def is_spatial_running():
    if os.path.exists(SPATIAL_PID_FILE):
        try:
            with open(SPATIAL_PID_FILE, "r", encoding="utf-8") as f:
                pid = int(f.read().strip())
            os.kill(pid, 0)
            return True
        except Exception:
            try:
                os.remove(SPATIAL_PID_FILE)
            except Exception:
                pass
    return False


def set_spatial_360(enable):
    currently_on = is_spatial_running()
    if enable and not currently_on:
        cmd = None
        if not os.path.exists(SPATIAL_SOFA_CONF):
            for candidate in [
                os.path.join(os.path.dirname(os.path.abspath(__file__)), "spatial-sofa.conf"),
                os.path.join(CONFIG_HOME, "quickshell", "MacShell", "assets", "spatial-sofa.conf"),
            ]:
                if os.path.exists(candidate):
                    try:
                        os.makedirs(os.path.dirname(SPATIAL_SOFA_CONF), exist_ok=True)
                        shutil.copyfile(candidate, SPATIAL_SOFA_CONF)
                        break
                    except Exception:
                        pass
        if os.path.exists(SPATIAL_SOFA_CONF) and command_exists("pipewire"):
            cmd = ["pipewire", "-c", SPATIAL_SOFA_CONF]
        elif command_exists("pw-loopback"):
            cmd = [
                "pw-loopback",
                '--capture-props=media.class=Audio/Sink node.name=macshell_spatial_360 node.description="360 Spatial Audio" audio.position=[FL FR]',
                "--playback-props=node.name=macshell_spatial_360.output stream.dont-remix=false",
            ]
        if cmd:
            proc = subprocess.Popen(
                cmd,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
            try:
                with open(SPATIAL_PID_FILE, "w", encoding="utf-8") as f:
                    f.write(str(proc.pid))
            except Exception:
                pass
            if command_exists("wpctl"):
                subprocess.Popen(
                    [
                        "sh",
                        "-c",
                        'sleep 0.35; id=$(wpctl status | awk \'/macshell_spatial_360/ {gsub(/[^0-9]/,"",$1); print $1; exit}\'); [ -n "$id" ] && wpctl set-default "$id"',
                    ],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    start_new_session=True,
                )
    elif not enable and currently_on:
        try:
            with open(SPATIAL_PID_FILE, "r", encoding="utf-8") as f:
                pid = int(f.read().strip())
            os.kill(pid, 15)
        except Exception:
            pass
        try:
            os.remove(SPATIAL_PID_FILE)
        except Exception:
            pass
        if command_exists("wpctl"):
            subprocess.Popen(
                [
                    "sh",
                    "-c",
                    'sleep 0.2; id=$(wpctl status | awk \'/bluez_output|bluez_sink/ {gsub(/[^0-9]/,"",$1); print $1; exit}\'); [ -n "$id" ] && wpctl set-default "$id"',
                ],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )


def ensure_a2dp_profile(mac):
    if not command_exists("pactl"):
        return
    card_mac = mac.replace(":", "_")
    cards_out = run_cmd(["pactl", "list", "cards", "short"], timeout=1.0)
    for line in cards_out.splitlines():
        if card_mac in line:
            parts = line.split()
            if len(parts) > 1:
                run_cmd(["pactl", "set-card-profile", parts[1], "a2dp-sink"], timeout=1.5)
            break


def crc16_ccitt(data: bytes) -> int:
    crc = 0x0000
    for b in data:
        crc ^= b << 8
        for _ in range(8):
            if crc & 0x8000:
                crc = ((crc << 1) ^ 0x1021) & 0xFFFF
            else:
                crc = (crc << 1) & 0xFFFF
    return crc


def build_samsung_spp_packet(msg_id: int, payload: bytes) -> bytes:
    body = bytes([msg_id]) + payload
    crc = crc16_ccitt(body)
    pkt_len = len(body) + 2
    header = struct.pack("<H", pkt_len & 0x03FF)
    return b"\xFD" + header + body + struct.pack("<H", crc) + b"\xDD"


def send_samsung_spp_async(mac: str, msg_id: int, payload: bytes, preferred_ch: int = 27):
    """Transmit Samsung SPP packet in a detached background fork with Samsung manager handshake."""
    if not mac or not bt_hardware_ready() or not hasattr(socket, "AF_BLUETOOTH"):
        return
    try:
        pid = os.fork()
        if pid > 0:
            return
    except Exception:
        return

    try:
        os.setsid()
        # Manager registration handshake (MsgId 0x88 = 136): ClientType=1 (Wearable App), IsSamsung=1, SdkVer=34 (0x22)
        handshake_pkt = build_samsung_spp_packet(0x88, bytes([0x01, 0x01, 0x22]))
        pkt = build_samsung_spp_packet(msg_id, payload)
        channels = [preferred_ch] + [c for c in (27, 20, 10, 11, 2, 1, 5, 3, 4) if c != preferred_ch]
        for ch in channels:
            s = None
            try:
                s = socket.socket(socket.AF_BLUETOOTH, socket.SOCK_STREAM, socket.BTPROTO_RFCOMM)
                s.settimeout(0.8)
                s.connect((mac, ch))
                # Send manager registration handshake first so the earbuds unlock Samsung host controls
                s.sendall(handshake_pkt)
                time.sleep(0.04)
                # Send the actual feature command
                s.sendall(pkt)
                time.sleep(0.06)
                s.close()
                if ch != preferred_ch:
                    st = load_state()
                    st["rfcommChannel"] = ch
                    save_state(st)
                break
            except Exception:
                if s:
                    try:
                        s.close()
                    except Exception:
                        pass
    except Exception:
        pass
    os._exit(0)


def send_via_daemon(kind: str, val) -> bool:
    if not os.path.exists(UNIX_SOCK_PATH):
        return False
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(0.3)
        s.connect(UNIX_SOCK_PATH)
        msg = json.dumps({"action": kind, "val": val}) + "\n"
        s.sendall(msg.encode("utf-8"))
        s.close()
        return True
    except Exception:
        return False


def dispatch_hardware_cmd(st: dict, kind: str, val):
    if not bt_hardware_ready():
        return
    if send_via_daemon(kind, val):
        return
    mac = st.get("selectedMac", "")
    pref_ch = int(st.get("rfcommChannel", 1) or 1)
    if not mac:
        for d in get_bt_audio_devices():
            if d["connected"]:
                mac = d["mac"]
                st["selectedMac"] = mac
                save_state(st)
                break
    if not mac:
        return

    if kind == "noise":
        mode_map = {"off": 0x00, "anc": 0x01, "ambient": 0x02, "adaptive": 0x03}
        send_samsung_spp_async(mac, 0x78, bytes([mode_map.get(val, 0x01)]), pref_ch)
        if command_exists("GalaxyBudsClient"):
            subprocess.Popen(
                ["GalaxyBudsClient", "--set-noise-control", str(val)],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
    elif kind == "eq":
        eq_map = {
            "Normal": 0x00,
            "Bass Boost": 0x01,
            "Soft": 0x02,
            "Dynamic": 0x03,
            "Clear": 0x04,
            "Treble Boost": 0x05,
        }
        send_samsung_spp_async(mac, 0x86, bytes([eq_map.get(val, 0x03)]), pref_ch)
        if command_exists("GalaxyBudsClient"):
            subprocess.Popen(
                ["GalaxyBudsClient", "--set-equalizer", str(val)],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
    elif kind == "touch":
        # 0x00 = All touch gestures disabled (Locked); 0x01 = All touch gestures enabled (Unlocked)
        touch_byte = 0x00 if val else 0x01
        send_samsung_spp_async(mac, 0x90, bytes([touch_byte] * 7), pref_ch)
    elif kind == "latency":
        send_samsung_spp_async(mac, 0x87, bytes([0x01 if val else 0x00]), pref_ch)


def get_status():
    st = load_state()
    drivers = load_drivers()
    devices = get_bt_audio_devices()

    active_dev = None
    for d in devices:
        if d["connected"]:
            active_dev = d
            break
    if not active_dev and st.get("selectedMac"):
        for d in devices:
            if d["mac"] == st["selectedMac"]:
                active_dev = d
                break
    if not active_dev and devices:
        active_dev = devices[0]

    dev_name = active_dev["name"] if active_dev else st.get("cachedName", "Wireless Buds")
    dev_mac = active_dev["mac"] if active_dev else st.get("selectedMac", "")
    connected = active_dev["connected"] if active_dev else False

    if active_dev and (st.get("selectedMac") != dev_mac or st.get("cachedName") != dev_name):
        st["selectedMac"] = dev_mac
        st["cachedName"] = dev_name
        save_state(st)

    drv = match_driver(dev_name, drivers)
    bat = get_earbuds_battery(active_dev["battery"] if active_dev else None, st)
    spatial_on = is_spatial_running()

    return {
        "connected": connected,
        "name": dev_name,
        "mac": dev_mac,
        "brand": drv["brand"],
        "driver": drv["id"],
        "codec": get_active_bt_codec() if connected else "Standby",
        "battery": bat,
        "noiseControl": st.get("noiseControl", "anc"),
        "supportedModes": drv["modes"],
        "eqPreset": st.get("eqPreset", "Dynamic"),
        "supportedEq": drv["eq"],
        "spatial360": spatial_on,
        "touchLock": bool(st.get("touchLock", False)),
        "lowLatency": bool(st.get("lowLatency", False)),
        "devices": devices,
        "installedDrivers": [d["id"] for d in drivers],
    }


def run_daemon():
    """Background listener daemon: holds RFCOMM channel open, syncs state from physical gestures, and handles fast local IPC."""
    if not hasattr(socket, "AF_BLUETOOTH"):
        sys.exit(1)

    def handle_exit(signum, frame):
        try:
            if os.path.exists(UNIX_SOCK_PATH):
                os.remove(UNIX_SOCK_PATH)
        except Exception:
            pass
        sys.exit(0)

    signal.signal(signal.SIGINT, handle_exit)
    signal.signal(signal.SIGTERM, handle_exit)

    try:
        if os.path.exists(UNIX_SOCK_PATH):
            os.remove(UNIX_SOCK_PATH)
    except Exception:
        pass

    unix_server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    unix_server.bind(UNIX_SOCK_PATH)
    unix_server.listen(5)
    unix_server.setblocking(False)

    mode_map = {"off": 0x00, "anc": 0x01, "ambient": 0x02, "adaptive": 0x03}
    mode_map_rev = {0x00: "off", 0x01: "anc", 0x02: "ambient", 0x03: "adaptive"}
    eq_map = {
        "Normal": 0x00,
        "Bass Boost": 0x01,
        "Soft": 0x02,
        "Dynamic": 0x03,
        "Clear": 0x04,
        "Treble Boost": 0x05,
    }
    eq_map_rev = {v: k for k, v in eq_map.items()}

    rfcomm_sock = None
    connected_mac = ""
    rx_buf = bytearray()

    def cleanup_rfcomm():
        nonlocal rfcomm_sock, connected_mac, rx_buf
        if rfcomm_sock:
            try:
                rfcomm_sock.close()
            except Exception:
                pass
            rfcomm_sock = None
        connected_mac = ""
        rx_buf.clear()

    while True:
        try:
            st = load_state()
            devs = get_bt_audio_devices()
            target_dev = None
            for d in devs:
                if d["connected"] and re.search(r"buds|galaxy|samsung", d["name"], re.I):
                    target_dev = d
                    break

            if not target_dev:
                cleanup_rfcomm()
                r, _, _ = select.select([unix_server], [], [], 2.0)
                if unix_server in r:
                    try:
                        conn, _ = unix_server.accept()
                        conn.close()
                    except Exception:
                        pass
                continue

            current_mac = target_dev["mac"]
            pref_ch = int(st.get("rfcommChannel", 27) or 27)

            if not rfcomm_sock or current_mac != connected_mac:
                cleanup_rfcomm()
                connected_mac = current_mac
                channels = [pref_ch] + [c for c in (27, 20, 10, 11, 2, 1, 5, 3, 4) if c != pref_ch]
                for ch in channels:
                    s = None
                    try:
                        s = socket.socket(socket.AF_BLUETOOTH, socket.SOCK_STREAM, socket.BTPROTO_RFCOMM)
                        s.settimeout(1.2)
                        s.connect((connected_mac, ch))
                        s.setblocking(False)
                        handshake = build_samsung_spp_packet(0x88, bytes([0x01, 0x01, 0x22]))
                        s.sendall(handshake)
                        rfcomm_sock = s
                        if ch != pref_ch:
                            st["rfcommChannel"] = ch
                            save_state(st)
                        break
                    except Exception:
                        if s:
                            try:
                                s.close()
                            except Exception:
                                pass
                if not rfcomm_sock:
                    cleanup_rfcomm()
                    time.sleep(2.0)
                    continue

            read_socks = [unix_server]
            if rfcomm_sock:
                read_socks.append(rfcomm_sock)

            r, _, _ = select.select(read_socks, [], [], 2.5)

            # Service local MacShell UI requests
            if unix_server in r:
                try:
                    conn, _ = unix_server.accept()
                    data = conn.recv(1024).decode("utf-8", "ignore").strip()
                    conn.close()
                    if data:
                        req = json.loads(data)
                        action = req.get("action")
                        val = req.get("val")
                        if rfcomm_sock and action:
                            if action == "noise":
                                pkt = build_samsung_spp_packet(0x78, bytes([mode_map.get(val, 0x01)]))
                                rfcomm_sock.sendall(pkt)
                            elif action == "eq":
                                pkt = build_samsung_spp_packet(0x86, bytes([eq_map.get(val, 0x03)]))
                                rfcomm_sock.sendall(pkt)
                            elif action == "touch":
                                touch_byte = 0x00 if val else 0x01
                                pkt = build_samsung_spp_packet(0x90, bytes([touch_byte] * 7))
                                rfcomm_sock.sendall(pkt)
                            elif action == "latency":
                                pkt = build_samsung_spp_packet(0x87, bytes([0x01 if val else 0x00]))
                                rfcomm_sock.sendall(pkt)
                except Exception:
                    pass

            # Service incoming earbud notifications (gestures, battery)
            if rfcomm_sock and rfcomm_sock in r:
                try:
                    chunk = rfcomm_sock.recv(1024)
                    if not chunk:
                        cleanup_rfcomm()
                        continue
                    rx_buf.extend(chunk)
                except Exception:
                    cleanup_rfcomm()
                    continue

                state_changed = False
                while len(rx_buf) >= 4:
                    try:
                        start = rx_buf.index(0xFD)
                    except ValueError:
                        rx_buf.clear()
                        break
                    if start > 0:
                        del rx_buf[:start]
                    if len(rx_buf) < 4:
                        break
                    pkt_len = struct.unpack("<H", rx_buf[1:3])[0] & 0x03FF
                    total_len = pkt_len + 4
                    if len(rx_buf) < total_len:
                        break
                    raw_pkt = rx_buf[:total_len]
                    del rx_buf[:total_len]

                    if raw_pkt[-1] == 0xDD:
                        body = raw_pkt[3 : 3 + pkt_len - 2]
                        if not body:
                            continue
                        msg_id = body[0]
                        pld = body[1:]

                        # 1. NOISE_CONTROLS_UPDATE (119 / 0x77) - sent by physical pinch/touch gestures
                        if msg_id == 0x77 and len(pld) >= 1:
                            new_mode_raw = pld[0]
                            new_mode = mode_map_rev.get(new_mode_raw)
                            if new_mode and st.get("noiseControl") != new_mode:
                                st["noiseControl"] = new_mode
                                state_changed = True
                                sys.stdout.write(f"[daemon] Gesture noise control: {new_mode}\n")
                                sys.stdout.flush()

                        # 2. NOISE_REDUCTION_MODE_UPDATE (155 / 0x9B) - ANC on/off
                        elif msg_id == 0x9B and len(pld) >= 1:
                            new_mode = "anc" if pld[0] == 1 else "off"
                            if st.get("noiseControl") != new_mode:
                                st["noiseControl"] = new_mode
                                state_changed = True
                                sys.stdout.write(f"[daemon] Gesture ANC mode: {new_mode}\n")
                                sys.stdout.flush()

                        # 3. AMBIENT_MODE_UPDATED (129 / 0x81) - Ambient on/off
                        elif msg_id == 0x81 and len(pld) >= 1:
                            new_mode = "ambient" if pld[0] == 1 else "off"
                            if st.get("noiseControl") != new_mode:
                                st["noiseControl"] = new_mode
                                state_changed = True
                                sys.stdout.write(f"[daemon] Gesture Ambient mode: {new_mode}\n")
                                sys.stdout.flush()

                        # 4. STATUS_UPDATED (96 / 0x60) - Battery updates
                        elif msg_id == 0x60 and len(pld) >= 3:
                            bat_l = int(pld[1])
                            bat_r = int(pld[2])
                            if st.get("batteryL") != bat_l or st.get("batteryR") != bat_r:
                                st["batteryL"] = bat_l
                                st["batteryR"] = bat_r
                                state_changed = True
                            if len(pld) >= 7 and pld[6] > 0:
                                st["batteryCase"] = int(pld[6])
                                state_changed = True

                        # 5. EXTENDED_STATUS_UPDATED (97 / 0x61) - Comprehensive state
                        elif msg_id == 0x61 and len(pld) >= 13:
                            new_mode_raw = pld[12]
                            new_mode = mode_map_rev.get(new_mode_raw)
                            if new_mode and st.get("noiseControl") != new_mode:
                                st["noiseControl"] = new_mode
                                state_changed = True
                                sys.stdout.write(f"[daemon] Status noise control: {new_mode}\n")
                                sys.stdout.flush()

                            bat_l = int(pld[2])
                            bat_r = int(pld[3])
                            if st.get("batteryL") != bat_l or st.get("batteryR") != bat_r:
                                st["batteryL"] = bat_l
                                st["batteryR"] = bat_r
                                state_changed = True

                            if len(pld) >= 7 and pld[6] > 0:
                                st["batteryCase"] = int(pld[6])
                                state_changed = True

                            if len(pld) >= 10:
                                eq_raw = pld[9]
                                new_eq = eq_map_rev.get(eq_raw)
                                if new_eq and st.get("eqPreset") != new_eq:
                                    st["eqPreset"] = new_eq
                                    state_changed = True

                if state_changed:
                    save_state(st)

        except Exception:
            time.sleep(2.0)


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "status"
    st = load_state()

    if cmd == "daemon":
        run_daemon()
    elif cmd == "status":
        print(json.dumps(get_status()))
    elif cmd == "set-mode" and len(sys.argv) > 2:
        mode = sys.argv[2]
        st["noiseControl"] = mode
        save_state(st)
        dispatch_hardware_cmd(st, "noise", mode)
        print(json.dumps({"ok": True, "noiseControl": mode}))
    elif cmd == "set-eq" and len(sys.argv) > 2:
        preset = sys.argv[2]
        st["eqPreset"] = preset
        save_state(st)
        dispatch_hardware_cmd(st, "eq", preset)
        print(json.dumps({"ok": True, "eqPreset": preset}))
    elif cmd == "toggle-360":
        target = not is_spatial_running() if len(sys.argv) <= 2 else (sys.argv[2] in ("1", "true", "on"))
        set_spatial_360(target)
        st["spatial360"] = target
        save_state(st)
        print(json.dumps({"ok": True, "spatial360": target}))
    elif cmd == "toggle-touch":
        target = (not st.get("touchLock", False)) if len(sys.argv) <= 2 else (sys.argv[2] in ("1", "true", "on"))
        st["touchLock"] = target
        save_state(st)
        dispatch_hardware_cmd(st, "touch", target)
        print(json.dumps({"ok": True, "touchLock": target}))
    elif cmd == "toggle-latency":
        target = (not st.get("lowLatency", False)) if len(sys.argv) <= 2 else (sys.argv[2] in ("1", "true", "on"))
        st["lowLatency"] = target
        save_state(st)
        dispatch_hardware_cmd(st, "latency", target)
        if command_exists("pw-metadata"):
            q_val = "256" if target else "0"
            subprocess.Popen(
                ["pw-metadata", "-n", "settings", "0", "clock.force-quantum", q_val],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
        print(json.dumps({"ok": True, "lowLatency": target}))
    elif cmd == "connect" and len(sys.argv) > 2:
        mac = sys.argv[2]
        st["selectedMac"] = mac
        save_state(st)
        if command_exists("bluetoothctl"):
            info = run_cmd(["bluetoothctl", "info", mac], timeout=1.2)
            if "Connected: yes" in info:
                run_cmd(["bluetoothctl", "disconnect", mac], timeout=5.0)
            else:
                run_cmd(["bluetoothctl", "trust", mac], timeout=1.5)
                run_cmd(["bluetoothctl", "connect", mac], timeout=10.0)
                time.sleep(0.4)
                ensure_a2dp_profile(mac)
        print(json.dumps(get_status()))
    else:
        print(json.dumps(get_status()))


if __name__ == "__main__":
    main()
